<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. Matches the teal gradient of the game badge so the
  circular foreground blends seamlessly. Keep in sync with
  scripts/generate-android-assets.sh (BG_TOP / BG_BOTTOM).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/ic_launcher_background_bottom"
        android:startColor="@color/ic_launcher_background_top"
        android:type="linear" />
</shape>