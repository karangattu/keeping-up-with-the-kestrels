# Supabase configuration for the Kestrels game.
# Copy this file to .env.local and fill in your project values.
# These are PUBLIC (publishable) keys — safe to expose in the browser build.
# Never put a Supabase service_role key here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
